{
  "name": "open-booking",
  "private": true,
  "version": "0.1.0",
  "description": "A lightweight, framework-agnostic, headless booking engine for small business websites.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @openbooking/docs dev",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck"
  },
  "keywords": [
    "booking",
    "scheduling",
    "availability",
    "calendar",
    "headless"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
